+
 @interface BridgedContentView ()
 
 // Dispatch |event| to |bridge_|'s host.
@@ -338,6 +348,24 @@ - (NSView*)hitTest:(NSPoint)point {
     return self;
   }
 
+  // Starry: send the event to the NSView of the NativeViewHost that views
+  // found here, not to whichever attached NSView is frontmost: an attached
+  // NSView is not clipped by its views ancestors, so where it is not visible it
+  // would take events meant for the web contents under it.
+  if (hitTestResult == remote_cocoa::mojom::HitTestResult::kSubView &&
+      _bridge->host_helper()) {
+    NSView* subview =
+        _bridge->host_helper()->GetNativeViewHostViewAt(flippedPoint);
+    if (subview && [subview isDescendantOf:self]) {
+      NSView* hit =
+          [subview hitTest:[subview.superview convertPoint:point
+                                                  fromView:self.superview]];
+      if (hit) {
+        return hit;
+      }
+    }
+  }
+
   return [super hitTest:point];
 }
 
