+NSView* NativeWidgetMacNSWindowHost::GetNativeViewHostViewAt(
+    const gfx::Point& location_in_content) {
+  if (!root_view_) {
+    return nullptr;
+  }
+  View* target_view = root_view_->GetEventHandlerForPoint(location_in_content);
+  if (!target_view || !views::IsViewClass<views::NativeViewHost>(target_view)) {
+    return nullptr;
+  }
+  auto it = attached_native_view_host_views_.find(target_view);
+  return it == attached_native_view_host_views_.end() ? nullptr : it->second;
+}
