-      "browser/ui/cocoa/applescript/scripting.sdef",
     ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
     public_deps = [
@@ -693,6 +697,7 @@ if (is_win) {
       ":chrome_app_strings",
       ":chrome_asset_catalog",
       "//components/policy:chrome_manifest_bundle",
+      "//starry/build/branding:scripting",
     ]
   }
 
@@ -1661,6 +1666,14 @@ group("dependencies") {
     "//v8:v8_headers",
   ]
 
+  # Starry: its browser-process and renderer code, on every desktop platform.
+  if (!is_android) {
+    public_deps += [
+      "//starry/browser",
+      "//starry/renderer",
+    ]
+  }
+
   if (enable_printing) {
     public_deps += [ "//printing" ]
   }
@@ -1679,12 +1692,22 @@ group("dependencies") {
 
 if (is_win) {
