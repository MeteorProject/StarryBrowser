   ]
+  if (is_win) {
+    public_deps = [ ":visual_elements_manifest" ]
+  } else {
+    sources +=
+        [ "app/visual_elements_resources/chrome.VisualElementsManifest.xml" ]
+  }
 
   if (is_chrome_branded) {
     sources += [
