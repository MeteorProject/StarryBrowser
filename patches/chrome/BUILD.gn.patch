-      "$root_out_dir/chrome.exe.pdb",
+      "$root_out_dir/${starry_product_id}.exe",
+      "$root_out_dir/${starry_product_id}.exe.pdb",
     ]
     args = [
       "-i",
@@ -101,6 +103,8 @@ if (is_win) {
