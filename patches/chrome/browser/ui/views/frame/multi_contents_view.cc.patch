 void MultiContentsView::SwapContentsInSplitView() {
-  // Reorder the child views so that focus order will be consistent with
-  // contents_container_views_.
-  ContentsContainerView* start_view = contents_container_views_[0];
-  ContentsContainerView* end_view = contents_container_views_[1];
-  size_t start_view_child_index = GetIndexOf(start_view).value();
-  size_t end_view_child_index = GetIndexOf(end_view).value();
-  ReorderChildView(start_view, end_view_child_index);
-  ReorderChildView(end_view, start_view_child_index);
-
-  std::swap(contents_container_views_[0], contents_container_views_[1]);
-
-  active_index_ = active_index_ == 0 ? 1 : 0;
+  auto* model = browser_view_->browser()->GetTabStripModel();
+  auto* active = model->GetActiveTab();
+  if (!active || !active->GetSplit()) {
+    return;
+  }
+  const auto tabs = model->GetSplitData(*active->GetSplit())->ListTabs();
+  std::vector<size_t> positions;
+  for (auto& container : contents_container_views_) {
+    positions.push_back(GetIndexOf(container).value());
+    auto* contents = container->contents_view()->web_contents();
+    if (contents && !std::ranges::any_of(tabs, [contents](auto* tab) {
+          return tab->GetContents() == contents;
+        })) {
+      // Only detach pages leaving the visible group. Keep the native view and
+      // compositor surface of retained pages attached throughout a rearrange.
+      if (container->Contains(GetFocusManager()->GetFocusedView())) {
+        GetFocusManager()->ClearFocus();
+      }
+      container->contents_view()->SetWebContents(nullptr);
+    }
+  }
+  std::ranges::sort(positions);
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    auto found = std::ranges::find_if(
+        contents_container_views_, [&](const auto& container) {
+          return container->contents_view()->web_contents() ==
+                 tabs[i]->GetContents();
+        });
+    if (found == contents_container_views_.end()) {
+      found = std::ranges::find_if(
+          contents_container_views_, [](const auto& container) {
+            return !container->contents_view()->web_contents();
+          });
+    }
+    CHECK(found != contents_container_views_.end());
+    std::iter_swap(contents_container_views_.begin() + i, found);
+    if (!contents_container_views_[i]->contents_view()->web_contents()) {
+      SetWebContentsAtIndex(tabs[i]->GetContents(), i);
+    }
+    if (tabs[i] == active) {
+      active_index_ = i;
+    }
+  }
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    ReorderChildView(contents_container_views_[i], positions[i]);
+    contents_container_views_[i]->SetVisible(i < tabs.size());
+  }
+  SetActiveIndex(active_index_);
+  InvalidateLayout();
 }
 
