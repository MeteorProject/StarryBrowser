starry_version_file = "//starry/VERSION"
starry_version = read_file(starry_version_file, "trim string")
assert(starry_version != "", "starry/VERSION must not be empty")

# Extract the SemVer core (MAJOR.MINOR.PATCH) and derive platform versions:
# - macOS CFBundleVersion: MAJOR.MINOR.PATCH (numeric only)
# - Windows PE / SxS / installer version: MAJOR.MINOR.PATCH.0
# - Linux deb/rpm: drop '+build', map '-prerelease' to '~prerelease', and
#   replace inner '-' with '.' so RPM accepts Version and sorts prereleases
#   before the final release.
_starry_version_no_build = string_split(starry_version, "+")
_starry_version_without_build = _starry_version_no_build[0]
_starry_version_dash_parts = string_split(_starry_version_without_build, "-")
_starry_version_core = _starry_version_dash_parts[0]

starry_mac_bundle_version = _starry_version_core
starry_windows_version = "${_starry_version_core}.0"
starry_windows_version_file = "$root_gen_dir/starry/build/win_version.txt"

if (_starry_version_without_build == _starry_version_core) {
  starry_linux_package_version = _starry_version_core
} else {
  _starry_version_prerelease =
      string_replace(_starry_version_without_build,
                     "${_starry_version_core}-",
                     "",
                     1)
  _starry_version_linux_pre =
      string_replace(_starry_version_prerelease, "-", ".")
  starry_linux_package_version =
      "${_starry_version_core}~${_starry_version_linux_pre}"
}
