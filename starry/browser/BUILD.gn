      "//chrome/browser/renderer_host:history_swiper",
      "//components/remote_cocoa/app_shim",
      "//components/remote_cocoa/common:mojo",
      "//ui/events/blink",
    ]
  }

  if (starry_devtools) {
    import("//starry_internal/browser/devtools.gni")
    defines = [ "STARRY_DEVTOOLS=1" ]
    sources += starry_devtools_sources
    deps += starry_devtools_deps
  }
}

if (starry_devtools) {
  group("devtools_tests") {
    testonly = true
    deps = [ "//starry_internal:all_tests" ]
  }
}
